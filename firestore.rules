rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPERS ---
    
    // Verifica si el usuario está autenticado como administrador
    function isAdmin() {
      return request.auth != null && request.auth.uid == "RCOUAepI2xRAyCP17zSNu9BswGH2";
    }

    // Verifica que solo se estén cambiando los campos permitidos
    function isOnlyUpdating(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // --- REGLAS ---

    // Colección de Posts (Portafolio/Blog)
    match /posts/{postId} {
      // Cualquiera puede leer los posts
      allow read: if true;
      
      // Solo el administrador puede crear o borrar posts
      allow create, delete: if isAdmin();
      
      // Actualización:
      // 1. El administrador puede editar todo.
      // 2. El público solo puede incrementar el contador de 'likes'.
      allow update: if isAdmin() || (
        isOnlyUpdating(['likes']) && 
        request.resource.data.likes == resource.data.likes + 1
      );

      // Subcolección de Comentarios
      match /comentarios/{commentId} {
        // Cualquiera puede leer los comentarios
        allow read: if true;
        
        // Cualquiera puede comentar, siempre que envíe los campos básicos
        allow create: if request.resource.data.autor != "" && 
                     request.resource.data.texto != "";
        
        // Solo el administrador puede editar o borrar comentarios
        allow update, delete: if isAdmin();
      }
    }
    
    // Denegar cualquier otro acceso por defecto
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
